# Backend / ops settings. The web app (frontend/) has its own frontend/.env.example.

# Cloud Functions secret (set via Firebase CLI, not in the web app):
# firebase functions:secrets:set GEMINI_API_KEY

# AI Crowd Prediction v2 (set after running: python ml/train_dosm.py)
# CROWD_DAILY_MODEL_PATH=ml/models/crowd_model_v1_dosm.onnx

# Kongsi Parking API (optional — enables real-time bay counts; falls back to DBKL static data)
KONGSI_API_URL=
KONGSI_API_KEY=

# orchestration-api internal base URL (used by mobility route to call /predict/crowd/daily)
SELF_BASE_URL=http://localhost:8000

# Slack bot internal ingress (set when running outside docker-compose)
# In docker-compose this resolves automatically via the service name.
SLACK_BOT_INGEST_URL=http://localhost:3001/ingest

# Shared secret for POST /webhook/alerts — callers must send X-Webhook-Secret: <value>
# Leave empty in local dev / trusted docker-compose networks.
WEBHOOK_SECRET=
