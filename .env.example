# Blink (required for auth, AI, and database)
VITE_BLINK_PROJECT_ID=
VITE_BLINK_PUBLISHABLE_KEY=

# Firebase (optional — enables cloud RAG; falls back to local knowledge without these)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-southeast1

# Cloud Functions secret (set via Firebase CLI, not in the web app):
# firebase functions:secrets:set GEMINI_API_KEY
