# Blink (required for auth, AI, and database)
VITE_BLINK_PROJECT_ID=
VITE_BLINK_PUBLISHABLE_KEY=

# Firebase (optional — enables cloud RAG; falls back to local knowledge without these)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-southeast1

# Cloud Functions secret (set via Firebase CLI, not in the web app):
# firebase functions:secrets:set GEMINI_API_KEY

# Google Maps (optional — enables the /map view)
VITE_GOOGLE_MAPS_API_KEY=

# BAS.MY GTFS-RT (optional — enables live bus arrivals; falls back to mock data)
VITE_BASMY_TOKEN=

# OpenTripPlanner (optional — enables real alternative route planning via Prasarana GTFS)
# Start OTP with: docker compose up otp
# See docker-compose.yml for seeding instructions
VITE_OTP_URL=http://localhost:8080/otp/routers/default/index/graphql

# Orchestration API (optional — enables ONNX crowd predictions, ClickHouse analytics)
VITE_ORCHESTRATION_API_URL=http://localhost:8000

# AI Crowd Prediction v2 (set after running: python ml/train_dosm.py)
# CROWD_DAILY_MODEL_PATH=ml/models/crowd_model_v1_dosm.onnx

# Kongsi Parking API (optional — enables real-time bay counts; falls back to DBKL static data)
KONGSI_API_URL=
KONGSI_API_KEY=

# orchestration-api internal base URL (used by mobility route to call /predict/crowd/daily)
SELF_BASE_URL=http://localhost:8000

# Slack bot internal ingress (set when running outside docker-compose)
# In docker-compose this resolves automatically via the service name.
SLACK_BOT_INGEST_URL=http://localhost:3001/ingest
