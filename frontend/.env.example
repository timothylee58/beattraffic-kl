# Server-side only: where the Next.js route handlers proxy /api/transit/* to (read at runtime).
API_URL=http://localhost:8000

# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time (set them before `npm run build`
# or as Docker build args). They are visible to every visitor: never put a secret in one.

# Blink (auth, tickets, AI, database)
NEXT_PUBLIC_BLINK_PROJECT_ID=
NEXT_PUBLIC_BLINK_PUBLISHABLE_KEY=

# Firebase (optional: enables cloud RAG; falls back to the local knowledge corpus without these)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-southeast1
# The Gemini key is a Cloud Functions secret, never a web env var: firebase functions:secrets:set GEMINI_API_KEY

# Google Maps (optional: enables /map). Restrict the key to your site's HTTP referrers in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# BAS.MY GTFS-RT (optional: live bus arrivals; mock data without it)
NEXT_PUBLIC_BASMY_TOKEN=

# OpenTripPlanner (optional: real alternative routes; start with `docker compose up otp`)
NEXT_PUBLIC_OTP_URL=http://localhost:8080/otp/routers/default/index/graphql

# Orchestration API, called directly from the browser (CORS_ORIGINS on the API must include this site)
NEXT_PUBLIC_ORCHESTRATION_API_URL=http://localhost:8000

# ML serving endpoints (optional; heuristics without them)
NEXT_PUBLIC_PREDICT_DELAYS_URL=
NEXT_PUBLIC_PREDICT_CROWD_URL=

# Events feed returning KLEvent[] (optional)
NEXT_PUBLIC_KL_EVENTS_URL=
