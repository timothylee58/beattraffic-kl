ANTHROPIC_API_KEY=
REDIS_URL=redis://redis:6379

# Transit graph + pgvector notices. Unset => bundled seed graph and in-memory synthetic notices.
DATABASE_URL=postgresql://beattraffic:beattraffic_dev@postgres:5432/beattraffic

# ridership_stats tool: read-only ClickHouse user (see infra/clickhouse/readonly_user.sql)
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_RO_USER=ridership_ro
CLICKHOUSE_RO_PASSWORD=

# Crowd model (ml/train_crowd_model.py output). Missing => time-of-day heuristic, flagged in answers.
CROWD_MODEL_PATH=

# MCP gateway audit trail (JSONL). Unset => in-memory only.
MCP_AUDIT_LOG=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
