ANTHROPIC_API_KEY=
REDIS_URL=redis://redis:6379

# Transit graph + pgvector notices. Leave UNSET to use the bundled seed graph and in-memory synthetic notices.
# Only enable after seeding: DATABASE_URL=... python -m scripts.seed_transit (from orchestration-api/)
# DATABASE_URL=postgresql://beattraffic:beattraffic_dev@postgres:5432/beattraffic

# ridership_stats tool: dedicated read-only ClickHouse user (see infra/clickhouse/readonly_user.sql).
# The tool refuses to run without CLICKHOUSE_RO_USER and uses the native protocol port (9000), not 8123.
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_NATIVE_PORT=9000
# CLICKHOUSE_RO_USER=ridership_ro
# CLICKHOUSE_RO_PASSWORD=

# Crowd model (ml/train_crowd_model.py output). Leave UNSET for the default path; a missing model falls back to a
# time-of-day heuristic that answers flag.
# CROWD_MODEL_PATH=ml/models/crowd_model.onnx

# MCP gateway audit trail (JSONL). Unset => in-memory only.
# MCP_AUDIT_LOG=/var/log/beattraffic/mcp_audit.jsonl

# Live crowd readings (see README, "Live gate-signal feed"). The ingestion endpoint is disabled until this is set;
# senders authenticate with the X-Gate-Feed-Token header.
# GATE_FEED_TOKEN=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Reverse proxies (IPs or CIDRs) whose X-Client-IP header is trusted for per-user rate limiting, e.g. the Next.js
# container's network. Leave unset when the API is exposed directly: the header is then ignored.
# TRUSTED_PROXIES=172.18.0.0/16
